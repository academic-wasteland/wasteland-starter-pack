    {
      "@id": "urn:wasteland:fair:concord:standards",
      "@type": "http://www.w3.org/ns/dcat#DataService",
      "kind": "service",
      "publisher": "urn:wasteland:town:concord",
      "title": "Concord operating standards and conformance evidence",
      "description": "Versioned opt-in operating profiles, executable local conformance vectors and dated test reports for independent towns.",
      "version": "1.0.0",
      "keywords": [
        "standards",
        "credentials",
        "revocation",
        "conformance",
