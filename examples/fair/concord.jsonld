          "title": "Profiles and execution reports",
          "semanticType": "http://semanticscience.org/resource/SIO_000015",
          "format": "application/json",
          "constraints": "Versioned profiles, requirement IDs, content digests and per-check outcomes; report coverage is explicitly bounded."
        }
      ],
      "access": {
        "town": "concord",
        "resident": "guide",
        "operation": "standards",
        "requirements": "Public read-only HTTPS; registered town identity for relay queries. Test adapters run locally under operator control.",
        "cost": "No automated billing.",
        "contact": "Message concord/guide, or propose changes in the starter-pack repository."
      },
      "documentation": "https://leechuck.de/wasteland-concord/",
      "provenance": "Maintained by Academic Wasteland. Reports identify profile digest, observer, implementation version, adapter and suite hashes.",
      "limitations": "Published reports are operator observations, not cryptographic certificates. Passing named synthetic checks does not grant trust, authorization or universal compliance.",
      "example": {
        "operation": "standards"
      }
    }
