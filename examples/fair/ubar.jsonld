  "@graph": [
    {
      "@id": "urn:wasteland:fair:ubar:indigena",
      "@type": "http://www.w3.org/ns/dcat#DataService",
      "kind": "service",
      "publisher": "urn:wasteland:town:ubar",
      "title": "INDIGENA phenotype similarity search",
      "description": "Resolve HPO/MP labels and exact synonyms, then rank mouse gene phenotype profiles using a locally trained INDIGENA TransD model. Identifier inputs remain supported. Supports pangenome interpretation research; does not analyze variants itself.",
      "version": "sha256:1929907252f233deaae07cb14fe1d77d09342ec0f11d66e910a6f2e94e2f1ff4",
      "keywords": [
        "phenotype",
        "phenotypes",
        "HPO",
        "MP",
        "MONDO",
        "gene prioritization",
        "pangenome interpretation",
        "INDIGENA"
      ],
      "subjects": [
        "http://purl.obolibrary.org/obo/hp.owl",
        "http://purl.obolibrary.org/obo/upheno.owl",
        "http://purl.obolibrary.org/obo/NCBITaxon_10090"
      ],
      "inputs": [
        {
          "@type": "http://semanticscience.org/resource/SIO_000015",
          "title": "Phenotype profile",
          "semanticType": "https://leechuck.de/wasteland-fair/vocabulary#PhenotypeProfile",
          "format": "application/json",
          "constraints": "phenotypes: 1\u201330 HPO/MP labels or HP, MP, UPHENO identifiers; prefix ambiguous labels with HPO: or MP:. Exact labels/synonyms only, never automatic fuzzy matching. limit: 1\u201350; method: indigena. Optional include_human_orthologues: boolean (default false)."
        }
      ],
      "outputs": [
        {
          "@type": "http://semanticscience.org/resource/SIO_000015",
          "title": "Ranked mouse gene profiles",
          "semanticType": "https://leechuck.de/wasteland-fair/vocabulary#RankedGeneProfiles",
          "format": "application/json",
          "constraints": "MGI identifiers, similarity scores, query and model provenance. Scores are not disease probabilities. Optional human orthologue annotations include HGNC IDs and symbols, with mapping source/date/SHA-256; original mouse ranking is preserved. Label resolution includes original input, resolved identifier, label, match type, ontology release and SHA-256."
        }
      ],
      "access": {
        "town": "ubar",
        "resident": "phenomancer",
        "operation": "phenotype-search",
        "requirements": "Registered relay town. Public bounded research query; no patient identifiers should be sent. Clinical or controlled-data access is not granted.",
        "cost": "No automated billing configured; contact the operator for sustained use.",
        "contact": "Send operation message to ubar with resident phenomancer."
      },
      "documentation": "https://github.com/academic-wasteland/pangenome-town/blob/main/docs/literature-and-phenotypes.md",
      "provenance": "Trained locally from INDIGENA commit 4fac38e8182231ffe07f80c66a2502ff70afb17b; Graph 4 inductive fold 0, seed 0, 400 dimensions, selected epoch 90, validation mean rank 134.7093. This is one training fold, not a clinical benchmark. Human annotations use the MGI HOM_ProteinCoding.rpt report; exact retrieval date and SHA-256 accompany each annotated result. Conflicting human mappings are excluded.",
      "limitations": "Mouse-model candidates with optional human orthologue annotations, not a validated human diagnostic ranking. MONDO IDs are not accepted query inputs. CC BY 4.0 applies to this project-authored service metadata and demo-generated result tables, credit Academic Wasteland; upstream model and source data retain their own terms and are not relicensed.",
      "example": {
        "operation": "phenotype-search",
        "phenotypes": [
          "HP:0001250",
          "HP:0001249"
        ],
        "limit": 5,
        "method": "indigena"
      },
      "license": "https://creativecommons.org/licenses/by/4.0/"
    },
    {
      "@id": "urn:wasteland:fair:ubar:q-temporal-kg",
      "@type": "http://semanticscience.org/resource/SIO_000015",
      "kind": "resource",
      "publisher": "urn:wasteland:town:ubar",
      "title": "Q: temporal knowledge graph documents and results",
      "description": "Selected formal definitions, reviews and validation results for temporal knowledge graphs, served by Ubar and explained by resident Q. Includes OWL Functional Syntax examples and documents about time and inference.",
      "version": "collection-2026-09-17",
      "keywords": [
        "temporal",
        "knowledge graph",
        "time",
        "ontology",
        "Q",
        "OWL",
        "documents"
      ],
      "subjects": [
        "http://www.w3.org/2006/time",
        "http://www.w3.org/2002/07/owl"
      ],
      "outputs": [
        {
          "@type": "http://semanticscience.org/resource/SIO_000015",
          "title": "Documents and ontology examples",
          "semanticType": "https://leechuck.de/wasteland-fair/vocabulary#TemporalKnowledgeGraphDocument",
          "format": "application/octet-stream",
          "constraints": "Selected Markdown, PDF, LaTeX, OWL Functional Syntax and validation text; request individual resource IDs."
        }
      ],
      "access": {
        "town": "ubar",
        "resident": "q",
        "operation": "resource",
        "requirements": "Registered relay town; only explicitly published files may be retrieved. A listed file does not imply permission to redistribute it.",
        "cost": "No automated billing configured; contact Q for sustained use.",
        "contact": "Send operation message to ubar with resident q."
      },
      "documentation": "https://github.com/academic-wasteland/pangenome-town/blob/main/docs/literature-and-phenotypes.md",
      "provenance": "Operator-selected local temporal-kg collection. Each retrieved file has its own SHA-256 digest. Source papers retain their original copyright; the collection does not grant rights over them.",
      "limitations": "This catalogue publishes metadata only. Papers outside the explicit resource allowlist are not served. Collection date is not a version of every document. Resource-specific licenses are not yet declared.",
      "example": {
        "operation": "resource",
        "id": "ca1ce20329fcf343172ab3c8",
        "offset": 0
      }
    },
    {
      "@id": "urn:wasteland:fair:ubar:variant-interpretation",
      "@type": "http://www.w3.org/ns/dcat#DataService",
      "kind": "service",
      "publisher": "urn:wasteland:town:ubar",
      "title": "Themis: evidence-traceable ACMG variant report",
      "description": "Re-evaluate a pinned ClinGen FBN1 expert curation and generate a PDF from one allele and phenotype terms. Initial evidence covers GRCh38 15:48421680 T>C, FBN1 c.7577A>G. Other alleles receive Not classified; this is not a general clinical classifier.",
      "version": "sha256:5e8e304a1b0a2a2ce5795440fa1abf81fffa155cd7e194ee6235f025e3a8ec5d",
      "keywords": [
        "variant interpretation",
        "ACMG",
        "REVEL",
        "privacy",
        "rare disease"
      ],
      "subjects": [
        "http://purl.obolibrary.org/obo/MONDO_0007947"
      ],
      "inputs": [
        {
          "@type": "http://semanticscience.org/resource/SIO_000015",
          "title": "Bounded research input",
          "semanticType": "http://semanticscience.org/resource/SIO_000015",
          "format": "application/json",
          "constraints": "One variant object: assembly GRCh38, chrom, pos, ref, alt; 1\u201330 resolved HP/MP phenotype identifiers; resident themis. VCF, genotype and patient metadata forbidden."
        }
      ],
      "outputs": [
        {
          "@type": "http://semanticscience.org/resource/SIO_000015",
          "title": "Research result and evidence",
          "semanticType": "http://semanticscience.org/resource/SIO_000015",
          "format": "application/json",
          "constraints": "ACMG criteria with strengths, sources and exclusions; classification; PDF base64 and SHA-256. Only the pinned expert allele has installed evidence."
        }
      ],
      "access": {
        "town": "ubar",
        "resident": "themis",
        "operation": "variant-interpretation",
        "requirements": "Registered relay town. Bounded research demonstration; no clinical sign-off. Never send a VCF or patient identifiers.",
        "cost": "No charge for this bounded demonstration",
        "contact": "ubar/themis"
      },
      "documentation": "https://github.com/academic-wasteland/pangenome-town/blob/main/docs/private-variant-demo.md",
      "provenance": "Academic Wasteland synthetic patient. Target evidence: ClinGen FBN1 VCEP 2023-06-15, curation f57714a2-598c-4e48-a07e-6858c037050e version 1.0.0; background annotations synthetic. REVEL 0.821; historical gnomAD absence.",
      "limitations": "Research demonstration selected to illustrate recovery of a known allele. Fixed synthetic VCF. Not clinical validation; annotation data are pinned, not live database queries. Own metadata and generated report prose CC BY 4.0; upstream evidence retains its own terms.",
      "example": {
        "operation": "variant-interpretation",
        "resident": "themis",
        "variant": {
          "assembly": "GRCh38",
          "chrom": "15",
          "pos": 48421680,
          "ref": "T",
          "alt": "C"
        },
        "phenotypes": [
          "HP:0001083",
          "HP:0001166",
          "HP:0002616"
        ]
      },
      "license": "https://creativecommons.org/licenses/by/4.0/"
    },
    {
      "@id": "urn:wasteland:fair:ubar:research-intake",
      "@type": "http://www.w3.org/ns/dcat#DataService",
      "kind": "service",
      "publisher": "urn:wasteland:town:ubar",
      "title": "Contact: phenotype research intake and delegation",
      "description": "Receive a human-readable synthetic research question with phenotype labels and workflow settings; reply with explanatory text and a bounded service delegation plan. The plan is selected from structured fields, not unrestricted natural-language interpretation.",
      "version": "intake-v1",
      "keywords": [
        "research intake",
        "delegation",
        "phenotypes",
        "private VCF"
      ],
      "subjects": [
        "http://purl.obolibrary.org/obo/hp.owl",
        "http://purl.obolibrary.org/obo/upheno.owl",
        "http://purl.obolibrary.org/obo/NCBITaxon_10090"
      ],
      "inputs": [
        {
          "@type": "http://semanticscience.org/resource/SIO_000015",
          "title": "Human question with structured phenotype payload",
          "semanticType": "http://semanticscience.org/resource/SIO_000015",
          "format": "application/json",
          "constraints": "text: 1\u20131200 characters; resident: contact; phenotypes: 1\u201330 labels or IDs; private_case: boolean. No VCF uploads or additional patient fields. workflow: phenotype-research."
        }
      ],
      "outputs": [
        {
          "@type": "http://semanticscience.org/resource/SIO_000015",
          "title": "Text reply and service delegation plan",
          "semanticType": "http://semanticscience.org/resource/SIO_000015",
          "format": "application/json",
          "constraints": "text plus ordered plan entries containing town, resident, operation and FAIR record where applicable; local VCF analysis remains at Yamatai."
        }
      ],
      "access": {
        "town": "ubar",
        "resident": "contact",
        "operation": "message",
        "requirements": "Registered town identity; human demo requests are relayed via Yamatai. No patient identifiers or genomic files.",
        "cost": "No automated billing configured; contact the operator for sustained use.",
        "contact": "ubar/contact"
      },
      "documentation": "https://github.com/academic-wasteland/pangenome-town/blob/main/docs/private-variant-demo.md",
      "provenance": "Academic Wasteland deterministic contact service; routes to Phenomancer, Yamatai local prioritization and Themis.",
      "limitations": "Synthetic research workflow only. No VCF or patient identifiers. A delegation is not a permission grant or clinical recommendation.",
      "example": {
        "operation": "message",
        "resident": "contact",
        "text": "Please help prioritize genes for a synthetic patient. Keep the VCF at Yamatai.",
        "phenotypes": [
          "HPO: Ectopia lentis",
          "HPO: Arachnodactyly",
          "HPO: Aortic root aneurysm"
        ],
        "private_case": true,
        "workflow": "phenotype-research"
      },
      "license": "https://creativecommons.org/licenses/by/4.0/"
    }
  ]
}
